@startuml
title Smart Campus - Activity diagram: Book room

start
:Student submits booking request (room, start, end);

if (Start in the future, duration above 0 and at most 2 hours? (R1)) then ([yes])
  if (Room blocked? (R3)) then ([no])
    if (Overlaps an active booking for this room? (R2)) then ([no])
      :Create booking with status ACTIVE;
      :Send confirmation to student (R4);
      :Show booking confirmed;
      stop
    else ([yes])
      :Reject booking - time slot unavailable;
      stop
    endif
  else ([yes])
    :Reject booking - room is blocked;
    stop
  endif
else ([no])
  :Reject booking - invalid time range;
  stop
endif

@enduml