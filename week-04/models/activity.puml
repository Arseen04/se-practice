@startuml
title Smart Campus - Activity diagram: Book room (revised)

start
:Student submits booking request (room, start, end);
note right
  Checks run in the order R1, R3, R2 (assumption).
  Back-to-back bookings do not overlap (A1).
  Nothing is saved on any rejection path.
end note

if (Start in the future, duration above 0 and at most 2 hours? (R1)) then ([yes])
  if (Room blocked? (R3)) then ([no])
    if (Overlaps an active booking for this room? (R2)) then ([no])
      :Create booking with status ACTIVE;
      :Send confirmation to student (R4);
      stop
    else ([yes])
      :Reject booking - R2, time slot already taken;
      stop
    endif
  else ([yes])
    :Reject booking - R3, room is blocked;
    stop
  endif
else ([no])
  :Reject booking - R1, start not in the future or duration outside 0 to 2 hours;
  stop
endif

@enduml